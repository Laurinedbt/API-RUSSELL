<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Russell - Port de plaisance</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <h1>Réservez votre catway au port de plaisance de Russell</h1>
    <form id="loginForm" action="/users/login" method="post">
        <fieldset>
            <legend>Connexion</legend><br>
            <label for="email">Adresse e-mail</label>
            <input type="email" name="email" id="email" required><br><br>

            <label for="password">Mot de passe</label>
            <input type="password" name="password" id="password" required><br><br>

            <input type="submit" value="Se connecter">
        </fieldset>
    </form>
    <p><a href="/api-docs">Voir la documentation de l'API</a></p>

</body>
</html>
